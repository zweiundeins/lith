# /etc/systemd/system/app.service
[Unit]
Description=app (Go, Datastar, SQLite)
After=network-online.target
Wants=network-online.target

[Service]
User=app
Group=app
# /var/lib/app holds the database and its backups, /run/app the socket.
# The app trusts the X-Forwarded-For of whoever connects to the socket, so
# only its group may enter /run/app, and the socket is 0660: Caddy's user
# joins the group app (usermod -aG app caddy, see README.md).
StateDirectory=app
RuntimeDirectory=app
RuntimeDirectoryMode=0750
WorkingDirectory=/var/lib/app
# Optional: APP_* settings the command line leaves out, and secrets.
EnvironmentFile=-/etc/app/app.env
# The app on the socket for Caddy, its metrics on 127.0.0.1:8180 for
# Prometheus only (observability/app.metrics.yml). Each app on a host needs
# a metrics port of its own: change it here, in SocketBindAllow and in
# app.metrics.yml.
ExecStart=/opt/app/app serve \
	-addr unix:/run/app/app.sock \
	-metrics 127.0.0.1:8180 \
	-db /var/lib/app/app.db \
	-secure \
	-streams 200
Restart=always
RestartSec=1
# SIGTERM: the streams end (pages reconnect to the next process), actions
# finish, the writer commits what is queued.
KillSignal=SIGTERM
TimeoutStopSec=20
LimitNOFILE=65536

# An open stream holds up to 2 MiB of compressor state, so -streams 200 needs
# about 400 MiB on top of the process. GOMEMLIMIT makes the garbage collector
# work harder before MemoryHigh throttles. Change the four together.
Environment=GOMEMLIMIT=448MiB
MemoryHigh=512M
MemoryMax=640M
TasksMax=256

# Network: loopback only, both ways, since Prometheus connects from 127.0.0.1
# to the metrics port (Caddy reaches the socket). The service may bind that
# port alone and reaches no other host, but on loopback it could reach the
# host's other services too (Caddy's admin API, databases). An app that
# calls out adds the addresses it needs to IPAddressAllow. To listen on a
# loopback port instead of the socket: -addr 127.0.0.1:8080,
# SocketBindAllow=tcp:8080, and point app.caddy there; then every local
# user can connect and name any client address.
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindAllow=tcp:8180
SocketBindDeny=any

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
