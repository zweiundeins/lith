# Caddy 2: the site block, with the real domain, as /etc/caddy/sites/app.caddy
# (the host's Caddyfile imports that folder). app compresses its pages and its
# streams itself, so there is no `encode`. A client that trickles its body
# holds Caddy's connection to it as long as Caddy allows; the app frees its
# own side (ReadTimeout, edge.Upload). Since Caddy 2.11.5 the global
# read_body is at most a ceiling sized to the host's slowest honest upload,
# request_body's read_timeout no longer exists, and HTTP/3 has no read_body,
# so lith leaves Caddy's timeouts to the host.
app.example.com {
	log {
		output file /var/log/caddy/app-access.log {
			mode 0640
			roll_size 100mb
			roll_keep 5
			roll_keep_for 720h
		}
		# A tab id lets whoever has it pace or end that tab's stream: the
		# log keeps a hash of it.
		format filter {
			wrap json
			fields {
				request>uri query {
					hash tab
				}
			}
		}
	}

	# app reads 8 KiB of an action at most; nothing it takes is larger.
	request_body {
		max_size 1MB
	}

	reverse_proxy unix//run/app/app.sock {
		# The client's address for the rate limits. app takes it only from
		# the socket or loopback, the last X-Forwarded-For address before
		# X-Real-IP, and a client cannot set either: these replace them.
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Real-IP {http.request.remote.host}
		# Server-sent events: pass every write through at once.
		flush_interval -1
	}
}
