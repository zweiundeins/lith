package views

import (
	"strconv"
	"time"

	"github.com/zweiundeins/lith/template/internal/guestbook"
)

// Page is what the guestbook's document shows.
type Page struct {
	Tab         string // new for every document: names the tab's stream and state
	Build       string // the build that renders it (live.Hub.Build)
	Assets      string // the version of its scripts and stylesheet
	Nonce       string // the request's CSP nonce, for the import map
	CSS, JS     string // URLs of the stylesheet and of Datastar
	NewestFrame string // URL of lith's newest-frame.js (live.NewestFrame)
	Entries     []guestbook.Entry
	Total       int
}

templ Guestbook(p Page) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<title>Guestbook</title>
			<link rel="icon" href="data:,"/>
			<link rel="stylesheet" href={ p.CSS }/>
			@importMap(p)
			<script type="module" src={ p.JS }></script>
			<script type="module" src={ p.NewestFrame }></script>
		</head>
		<body data-newest-frame data-on:newest-frame-behind={ behind }>
			<main data-signals={ signals(p) }>
				<div id="stream" hidden data-init={ openStream } data-on:datastar-fetch={ retrying } data-on:visibilitychange__window={ hidden }></div>
				<div id={ OpsID } hidden data-on:datastar-fetch={ fetched } data-on-signal-patch={ patched } data-on-signal-patch-filter={ opsPatches }></div>
				@Update("")
				@Content(p.Entries, p.Total)
			</main>
		</body>
	</html>
}

// Content is what a refresh after a deploy renders afresh (web.refresh):
// everything but the stream's element, the ops and the signals, which
// stay outside it.
templ Content(list []guestbook.Entry, total int) {
	<div id="content">
		<h1>Guestbook</h1>
		<form data-on:input={ typed } data-on:submit__prevent={ sign }>
			<label>
				<span>Name</span>
				<input data-bind="_name" maxlength={ strconv.Itoa(guestbook.MaxName) } required autocomplete="name" data-attr:readonly={ pending } data-preserve-attr="readonly"/>
			</label>
			<label>
				<span>Message</span>
				<textarea data-bind="_message" maxlength={ strconv.Itoa(guestbook.MaxMessage) } required rows="3" data-attr:readonly={ pending } data-preserve-attr="readonly"></textarea>
			</label>
			<button type="submit" data-attr:aria-busy={ busy } data-preserve-attr="aria-busy">Sign</button>
			@Outcome(guestbook.TabState{})
			<p class="problem" role="alert" data-show="$_problem" data-text="$_problem"></p>
		</form>
		@Entries(list, total)
	</div>
}

// Update asks for a reload where a refresh would not do: the person has
// typed into the page (UpdateTyped), or its scripts and stylesheet changed
// (UpdateAssets). "" renders it empty.
templ Update(msg string) {
	<p id="update" role="status">
		if msg != "" {
			{ msg }
			<button type="button" data-on:click="location.reload()">Reload</button>
		}
	</p>
}

// Outcome is the tab's own region: what became of its last signature.
templ Outcome(s guestbook.TabState) {
	<p
		id="outcome"
		role="status"
		if s.Refusal != "" {
			class="refused"
		}
	>
		if s.Refusal != "" {
			{ s.Refusal }
		} else if s.Accepted() {
			Thank you for signing.
		}
	</p>
}

// Notice takes the outcome's place for what no command decided: a failed
// write, a rate limit, a server that stops. The tab's view puts the
// outcome back with its next frame.
templ Notice(msg string) {
	<p id="outcome" role="status" class="refused">{ msg }</p>
}

// Entries is the shared region: the newest entries, the same for every tab.
templ Entries(list []guestbook.Entry, total int) {
	<section id="entries" aria-labelledby="entries-count">
		<h2 id="entries-count">{ count(total) }</h2>
		<ul>
			for _, e := range list {
				<li id={ "entry-" + strconv.FormatInt(e.ID, 10) }>
					<p>{ e.Message }</p>
					<p class="by">{ e.Name }, <time datetime={ e.At.UTC().Format(time.RFC3339) }>{ e.At.UTC().Format("2 Jan 2006, 15:04 UTC") }</time></p>
				</li>
			}
		</ul>
	</section>
}
