    {
      "id": 33,
      "title": "Projector status",
      "description": "Each projector's status: live, rebuilding (a new version of an inline projector fills copies of its tables), or parked (a catch-up projector stopped at an event that kept failing, until Resume or the next Run). With several slots, the worst of them.",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 52
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "live",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "rebuilding",
                  "color": "blue",
                  "index": 1
                },
                "2": {
                  "text": "parked",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.9,
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (app, projector) (2 * {__name__=\"${ns}_events_projector_status\", status=\"parked\", app=~\"$app\", slot=~\"$slot\"} + ignoring (status) {__name__=\"${ns}_events_projector_status\", status=\"rebuilding\", app=~\"$app\", slot=~\"$slot\"})",
          "legendFormat": "{{app}} {{projector}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
