package stream

import "github.com/zweiundeins/lith/site/internal/views"

// Stage is the demo on its page: the readout of the tab's own stream, the
// site's streams and their budget, and the payload with its controls. Only
// the table is morphed; the reports and the choices arrive as signals.
templ Stage(st TabState, p Payload) {
	<div class="sx" data-signals={ signals(st) } data-on-interval__duration.1s={ tick }>
		<section class="sx-panel sx-readout" aria-labelledby="stream-readout-title">
			<header class="sx-head">
				<h3 id="stream-readout-title" class="sx-eyebrow">Your stream</h3>
				<p class="sx-pace" data-class:is-live="$_live" data-class:is-quiet="$_stream.quiet >= 2">
					<span class="sx-dot" aria-hidden="true"></span>
					<span data-show="!$_live">connecting</span>
					<span data-show="$_live && $_stream.quiet >= 2" style="display: none">quiet for <b data-text="$_stream.quiet">0</b> s</span>
					<span data-show="$_live && $_stream.quiet < 2" style="display: none"><b data-text="$_stream.fps">0</b> frames a second</span>
				</p>
			</header>
			<div class="sx-encoder">
				<p class="sx-coding" data-attr:data-coding="$_stream.coding" data-text="$_stream.coding || '…'">…</p>
				<dl class="sx-pairs">
					<div>
						<dt>Setting from the budget</dt>
						<dd><code data-text="$_stream.tier || 'waiting'">waiting</code></dd>
					</div>
					<div>
						<dt>Reserved for your encoder</dt>
						<dd data-text="$_stream.heap || 'waiting'">waiting</dd>
					</div>
				</dl>
			</div>
			<div class="sx-heroes" data-class:is-ready="$_stream.n > 0">
				<div class="sx-hero">
					<p class="sx-big" data-class:is-fine="$_stream.fr < 100">
						<span class="sx-count sx-count--ratio" aria-hidden="true" data-style:--stream-count="$_stream.fr"></span>
						<span class="sx-unit" aria-hidden="true">:1</span>
						<span class="visually-hidden" data-text="$_stream.ratio + ' to 1'"></span>
					</p>
					<p class="sx-caption">The last frame, events to wire</p>
					<div class="sx-bars" aria-hidden="true">
						<p class="sx-bar"><span>events</span><i style="--stream-fill: 100"></i><b data-text="$_stream.fe"></b></p>
						<p class="sx-bar is-wire"><span>wire</span><i data-style:--stream-fill="$_stream.fp"></i><b data-text="$_stream.fwt"></b></p>
					</div>
				</div>
				<div class="sx-hero">
					<p class="sx-big" data-class:is-kb="$_stream.fw >= 10000">
						<span class="sx-count sx-count--bytes" aria-hidden="true" data-style:--stream-count="$_stream.fw"></span>
						<span class="sx-unit sx-unit--spaced" aria-hidden="true" data-text="$_stream.fw >= 10000 ? 'KB' : 'B'">B</span>
						<span class="visually-hidden" data-text="$_stream.fwt"></span>
					</p>
					<p class="sx-caption">On the wire, frame by frame</p>
					<sb-sparkline class="sx-spark" length="60" tone="brand" label="Bytes on the wire per frame" data-effect={ push }></sb-sparkline>
				</div>
			</div>
			<dl class="sx-tiles">
				<div>
					<dt>Events sent</dt>
					<dd data-text="$_stream.events"></dd>
				</div>
				<div>
					<dt>On the wire</dt>
					<dd data-text="$_stream.wire"></dd>
				</div>
				<div>
					<dt>Ratio so far</dt>
					<dd data-text="$_stream.total"></dd>
				</div>
				<div>
					<dt>Heartbeats</dt>
					<dd data-text="$_stream.beats"></dd>
				</div>
			</dl>
		</section>
		<section class="sx-panel sx-site" aria-labelledby="stream-site-title">
			<header class="sx-head">
				<h3 id="stream-site-title" class="sx-eyebrow">The site</h3>
				<p class="sx-streams"><b data-text="$_stream.streams">0</b> <span data-text="$_stream.streams === 1 ? 'stream open on this site' : 'streams open on this site'">streams open on this site</span></p>
			</header>
			<sb-meter class="sx-meter" label="Budget for the streams" unit="%" segments="24" value="0" data-attr:value="Math.max(0, $_stream.budget)" data-preserve-attr="value" data-show="$_stream.budget >= 0" style="display: none"></sb-meter>
			<p class="sx-budget">
				<b data-text="$_stream.reserved || 'nothing'">nothing</b> reserved
				<span data-show="$_stream.budget >= 0" style="display: none">of a limit of <b data-text="$_stream.limit"></b></span>
				<span data-show="$_stream.budget < 0">: this process has no memory limit, so the budget only counts</span>
			</p>
			<p class="sx-tiers" data-show="$_stream.tiers" style="display: none">By setting: <span data-text="$_stream.tiers"></span></p>
		</section>
		<section class="sx-panel sx-payload" aria-labelledby="stream-payload-title">
			<header class="sx-head">
				<h3 id="stream-payload-title" class="sx-eyebrow">The payload</h3>
				<div class="sx-controls" data-on:datastar-fetch={ failed } data-effect={ settle }>
					@choiceGroup("size", "Size", string(st.size()), sizeOptions)
					@choiceGroup("churn", "Churn", string(st.churn()), churnOptions)
				</div>
			</header>
			<p class="outcome is-problem" role="alert" data-show="$_stream.problem" data-text="$_stream.problem"></p>
			@note(p)
			<div class="sx-scroll" tabindex="0" role="region" aria-label="The payload table">
				@table(p)
			</div>
		</section>
	</div>
}

// option is a button of a choice.
type option struct{ value, label string }

var (
	sizeOptions  = []option{{string(Small), "Small"}, {string(Medium), "Medium"}, {string(Large), "Large"}}
	churnOptions = []option{{string(Still), "Still"}, {string(Calm), "Calm"}, {string(Busy), "Busy"}, {string(Storm), "Storm"}}
)

// choiceGroup is a row of buttons, the tab's choice pressed. The server
// presses them through the tab's signals; a click only marks its button
// pending.
templ choiceGroup(field, label, current string, options []option) {
	<div class="sx-choice" role="group" aria-labelledby={ "stream-" + field + "-label" }>
		<span id={ "stream-" + field + "-label" } class="sx-label">{ label }</span>
		<div class="choice">
			for _, o := range options {
				<button
					type="button"
					aria-pressed={ pressedText(current == o.value) }
					data-attr:aria-pressed={ pressed(field, o.value) }
					data-attr:aria-busy={ busy(field, o.value) }
					data-on:click={ choose(field, o.value) }
				>{ o.label }</button>
			}
		</div>
	</div>
}

func pressedText(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

// Table is the frame the tab's table view sends every step: the note and
// the table, each morphed into the page by its id. Cells that changed in
// the step carry data-new, which lights them up.
templ Table(p Payload) {
	@note(p)
	@table(p)
}

templ note(p Payload) {
	<p id="stream-payload-note" class="sx-note">{ caption(p) }</p>
}

templ table(p Payload) {
	<table id="stream-payload" class="sx-table">
		<thead>
			<tr>
				<th scope="col">node</th>
				for _, c := range columns {
					<th scope="col">{ c }</th>
				}
			</tr>
		</thead>
		<tbody>
			for _, r := range p.Rows {
				<tr>
					<th scope="row">{ r.Name }</th>
					for _, c := range r.Cells {
						<td data-new?={ c.New }>{ c.Text }</td>
					}
				</tr>
			}
		</tbody>
	</table>
}

// Embed is the landing page's slot: this page's own stream, from the
// reports its writes carry.
templ Embed() {
	<div class="sx-embed" data-signals={ embedSignals }>
		<p class="sx-embed__head" data-class:is-live="$_live"><span class="sx-dot" aria-hidden="true"></span>This page's stream, live</p>
		<div class="sx-embed__body">
			<p class="sx-coding" data-attr:data-coding="$_stream.coding" data-text="$_stream.coding || '…'">…</p>
			<p class="sx-embed__tier"><code data-text="$_stream.tier || 'waiting'">waiting</code> from the memory budget</p>
		</div>
		<dl class="sx-embed__nums">
			<div>
				<dt>Frames</dt>
				<dd data-text="$_stream.n">0</dd>
			</div>
			<div>
				<dt>Ratio so far</dt>
				<dd data-text="$_stream.total || '1:1'">1:1</dd>
			</div>
			<div>
				<dt>Last frame</dt>
				<dd data-text="$_stream.n > 0 ? $_stream.fwt : 'waiting'">waiting</dd>
			</div>
		</dl>
		<p class="sx-embed__note" data-show="$_stream.n <= 1">The first frame has no frame before it to refer back to. The frames after it do, and cost far less.</p>
		<sb-sparkline class="sx-spark" length="40" tone="brand" label="Bytes on the wire per frame of this page's stream" data-show="$_stream.n >= 3" style="display: none" data-effect={ push }></sb-sparkline>
		<a class="btn btn--sm" href="/demos/stream">
			Inspect every number
			@views.Icon("arrow-right")
		</a>
	</div>
}
