package views

// DemoPage is a demo's own page.
type DemoPage struct {
	Card   Card
	Server templ.Component // what the server does (Markdown, rendered)
	How    templ.Component // how it works (Markdown, rendered)
	Stage  templ.Component // the demo itself, in its data-demo element
}

templ Demo(d DemoPage) {
	<div class="wrap demo-page">
		@DemoHead(d.Card)
		<div class="demo-body">
			<section class="demo-stage" aria-labelledby="demo-stage-title">
				<h2 id="demo-stage-title" class="visually-hidden">The demo</h2>
				<p class="live-badge" data-class:is-live="$_live && !$_badge" data-class:is-held="$_live && !!$_badge" data-text="$_live ? $_badge || 'live' : 'connecting'">live</p>
				@d.Stage
			</section>
			@DemoServer(d.Server)
		</div>
		@DemoHow(d.How)
	</div>
}

// DemoHead, DemoServer and DemoHow are the parts of a demo's page around
// its stage, which a refresh after a deploy renders afresh by their ids
// (web.Server.refresh). The stage is the demo's views'.
templ DemoHead(c Card) {
	<header id="demo-head" class="demo-head" style={ vtName("demo-" + c.Slug) }>
		<p class="crumbs"><a href="/demos">Demos</a></p>
		<div class="demo-head__art" style={ vtName("demo-" + c.Slug + "-art") }>
			@Art(c.Art, "")
		</div>
		<h1 style={ vtName("demo-" + c.Slug + "-title") }>{ c.Title }</h1>
		<p class="lede">{ c.Summary }</p>
	</header>
}

templ DemoServer(server templ.Component) {
	<aside id="demo-server" class="panel" aria-labelledby="server-title">
		<h2 id="server-title">On the server</h2>
		<div class="prose prose--small">
			@server
		</div>
	</aside>
}

templ DemoHow(how templ.Component) {
	<details id="demo-how" class="howto" data-preserve-attr="open">
		<summary>How it works</summary>
		<div class="prose">
			@how
		</div>
	</details>
}

templ DemoIndex(cards []Card) {
	<div class="wrap">
		<header class="page-intro">
			<h1 class="page-title">Demos</h1>
			<p>Each demo runs on this server, on lith. Open one in two windows to see the other's changes arrive.</p>
		</header>
		@CardGrid(cards, 2)
	</div>
}

templ NotFound() {
	<div class="wrap lost">
		@Art(logoSVG, "")
		<h1 class="page-title display">Nothing here</h1>
		<p>This page does not exist, or not any more.</p>
		<a class="btn btn--primary" href="/">To the start</a>
	</div>
}
