package web

import (
	"strconv"

	"github.com/zweiundeins/lith/site/internal/docs/example/board"
)

// PageData is what the board's document shows.
type PageData struct {
	Tab      string // new for every document: names the tab's stream and its row
	Build    string // the build that renders it (live.Hub.Build)
	Datastar string // the URL of Datastar's script
	Board    board.Board
	Lanes    [][]byte // each lane rendered, as the board's view renders them
	Prefs    board.Prefs
}

templ Page(p PageData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.Board.Name }</title>
			<script type="module" src={ p.Datastar }></script>
		</head>
		<body>
			<main data-signals={ signals(p.Tab, p.Build, p.Prefs) } data-class:compact="$_compact">
				<div id={ StreamID } hidden data-init={ "$_beat = Date.now(); " + openStream(p.Board.ID) } data-on:datastar-fetch={ retrying } data-on:visibilitychange__window={ hidden } data-effect={ beat } data-on-interval__duration.10s={ watchdog(p.Board.ID) }></div>
				<div id={ OpsID } hidden data-on:datastar-fetch={ fetched } data-on-signal-patch={ patched } data-on-signal-patch-filter={ opsPatches }></div>
				<p id="update" role="status"></p>
				@Content(p.Board, p.Lanes)
			</main>
		</body>
	</html>
}

// Content is the page but its signals, the stream's element and #ops: what
// a refresh after a deploy renders afresh.
templ Content(b board.Board, lanes [][]byte) {
	<div id="content">
		<h1>{ b.Name }</h1>
		@Presence(0)
		<button type="button" data-on:click={ compact } data-text="$_compact ? 'Show details' : 'Compact'">Compact</button>
		<form data-on:input={ typed } data-on:submit__prevent={ add(firstLane(b)) }>
			<input data-bind="_title" maxlength={ strconv.Itoa(board.MaxTitle) } required aria-label="New card" data-attr:readonly={ pending("add") } data-preserve-attr="readonly"/>
			<button type="submit" data-attr:aria-busy={ busy("add") } data-preserve-attr="aria-busy">Add</button>
		</form>
		<p class="problem" role="alert" data-show="$_problem" data-text="$_problem"></p>
		@Outcome(board.TabState{})
		@Board(lanes)
		@NoPanel()
		<style data-text={ waitingCards }></style>
	</div>
}

// Update asks for a reload in place of a refresh: the page holds a title
// the person typed, which a morph of the form would take.
templ Update() {
	<p id="update" role="status">This board has a new version. Reloading clears the form. <button type="button" data-on:click="location.reload()">Reload</button></p>
}

// Board is the shared region, the same for every viewer: the lanes,
// rendered one by one. A click on a card's button is handled here, on the
// board, so a frame carries no expression per card.
templ Board(lanes [][]byte) {
	<div id="board" data-on:click={ onBoard }>
		for _, l := range lanes {
			@templ.Raw(string(l))
		}
	</div>
}

// Lane is one lane, morphed in by its id. next is the lane its cards move
// on to, 0 for the last.
templ Lane(l board.Lane, next int64) {
	<section id={ "lane-" + id(l.ID) } class="lane">
		<h2>{ l.Name } <span class="count">{ strconv.Itoa(len(l.Cards)) }/{ strconv.Itoa(l.Max) }</span></h2>
		<ol>
			for _, c := range l.Cards {
				<li id={ "card-" + id(c.ID) }>
					<button type="button" data-card={ id(c.ID) }>{ c.Title }</button>
					if next != 0 {
						<button type="button" data-card={ id(c.ID) } data-lane={ id(next) } data-seen={ id(c.Version) } aria-label="Move on">→</button>
					}
				</li>
			}
		</ol>
	</section>
}

// Outcome is the tab's own region: why its last action changed nothing.
templ Outcome(s board.TabState) {
	<p id="outcome" role="status">{ s.Refusal }</p>
}

// Notice takes the outcome's place for what no command decided: a writer
// that failed, a rate limit, a server that stops. The tab's view puts the
// outcome back with its next frame.
templ Notice(msg string) {
	<p id="outcome" role="status" class="notice">{ msg }</p>
}

// Presence says how many tabs show the board.
templ Presence(n int) {
	<p id="presence">{ people(n) }</p>
}

// Panel is a card's details, in the tabs that opened it.
templ Panel(c board.Card) {
	<aside id="panel">
		<h2>{ c.Title }</h2>
		<p>Version { strconv.FormatInt(c.Version, 10) }</p>
		<button type="button" data-on:click={ panel("0") }>Close</button>
	</aside>
}

// NoPanel holds the panel's place while none is open.
templ NoPanel() {
	<aside id="panel" hidden></aside>
}
