{
  "title": "lith apps",
  "uid": "lith-apps",
  "description": "Any app on lith (github.com/zweiundeins/lith) whose metrics Prometheus scrapes: the HTTP requests by route, the live hub's ticks, renders and frames, the writer, the streams' memory budget, the statements, the process. Pick the app's metric namespace (lith_site for lith's website), then the job and the app. The HTTP panels need the app to export <ns>_http_requests_total{route,code} and <ns>_http_request_duration_seconds{route}, as lith-site's internal/metrics does; the rest comes from lith/prom and lith/dbmetrics/prom.",
  "tags": [
    "lith",
    "go"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "ns",
        "type": "query",
        "label": "Namespace",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-ds"
        },
        "query": "label_values({__name__=~\".+_writer_commands_total\"}, __name__)",
        "regex": "/^(.+)_writer_commands_total$/",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "lith_site",
          "value": "lith_site"
        }
      },
      {
        "name": "job",
        "type": "query",
        "label": "Job",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-ds"
        },
        "query": "label_values({__name__=\"${ns}_writer_commands_total\"}, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "app",
        "type": "query",
        "label": "App",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-ds"
        },
        "query": "label_values({__name__=\"${ns}_writer_commands_total\", job=~\"$job\"}, app)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Requests: in the app, by ServeMux pattern ($ns)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Requests by route",
      "description": "Requests a second by route, the ServeMux pattern that matched (\"GET /demos/{slug}\"), never the raw path. \"edge\" counts what the edge answered before the mux (a refused cross-site action), \"/\" the catch-all (404s). Event streams count once, when they end.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app, route) (rate({__name__=\"${ns}_http_requests_total\", job=~\"$job\", app=~\"$app\"}[$__rate_interval]))",
          "legendFormat": "{{app}} {{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "5xx by route",
      "description": "Server errors a second by route. A 503 on a stream route is the stream cap or the budget's refusal; a restart's 503s are Caddy's, not counted here.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app, route, code) (rate({__name__=\"${ns}_http_requests_total\", job=~\"$job\", app=~\"$app\", code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{app}} {{route}} {{code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "p95 latency by route",
      "description": "95th percentile of the time to answer, by route. Event streams are left out of the histogram: they last as long as their tab.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (app, route, le) (rate({__name__=\"${ns}_http_request_duration_seconds_bucket\", job=~\"$job\", app=~\"$app\"}[$__rate_interval])))",
          "legendFormat": "{{app}} {{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Live: the tick, renders, frames and streams",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 6,
      "title": "Open streams",
      "description": "Streams open now (the tabs that watch views), and requests in flight, streams included.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) ({__name__=\"${ns}_live_streams\", job=~\"$job\", app=~\"$app\"})",
          "legendFormat": "{{app}} streams",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (app) ({__name__=\"${ns}_http_requests_in_flight\", job=~\"$job\", app=~\"$app\"})",
          "legendFormat": "{{app}} requests in flight",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Ticks per second and overruns",
      "description": "Ticks that rendered views, a second. An overrun is a tick that took longer than the tick (50 ms by default); the app also logs their percentiles.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (rate({__name__=\"${ns}_live_ticks_total\", job=~\"$job\", app=~\"$app\"}[$__rate_interval]))",
          "legendFormat": "{{app}} ticks",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (app) (rate({__name__=\"${ns}_live_tick_overruns_total\", job=~\"$job\", app=~\"$app\"}[$__rate_interval]))",
          "legendFormat": "{{app}} overruns",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "Renders per tick",
      "description": "Views rendered per tick. Shared views render once for all their streams, so this follows the number of distinct views that change, not the number of tabs.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (rate({__name__=\"${ns}_live_renders_total\", job=~\"$job\", app=~\"$app\"}[$__rate_interval])) / sum by (app) (rate({__name__=\"${ns}_live_ticks_total\", job=~\"$job\", app=~\"$app\"}[$__rate_interval]))",
          "legendFormat": "{{app}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          }
        }
      ]
    },
    {
      "id": 9,
      "title": "Frames sent and dropped per second",
      "description": "Frames written to streams, and frames a newer one replaced before their stream sent them: a slow client skips frames and holds up nobody else.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (rate({__name__=\"${ns}_live_frames_sent_total\", job=~\"$job\", app=~\"$app\"}[$__rate_interval]))",
          "legendFormat": "{{app}} sent",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (app) (rate({__name__=\"${ns}_live_frames_dropped_total\", job=~\"$job\", app=~\"$app\"}[$__rate_interval]))",
          "legendFormat": "{{app}} dropped",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          }
        }
      ]
    },
    {
      "id": 10,
      "title": "Views watched and read transactions",
      "description": "Views watched now, and the render workers' read transactions a second (at most one per worker and tick).",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) ({__name__=\"${ns}_live_views\", job=~\"$job\", app=~\"$app\"})",
          "legendFormat": "{{app}} views",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (app) (rate({__name__=\"${ns}_live_read_txs_total\", job=~\"$job\", app=~\"$app\"}[$__rate_interval]))",
          "legendFormat": "{{app}} read transactions/s",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Writer: one writer, batches with a savepoint per command",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "panels": []
    },
    {
      "id": 12,
      "title": "Commands per second",
      "description": "Commands the writer ran, failed ones included.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (rate({__name__=\"${ns}_writer_commands_total\", job=~\"$job\", app=~\"$app\"}[$__rate_interval]))",
          "legendFormat": "{{app}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          }
        }
      ]
    },
    {
      "id": 13,
      "title": "Commands per batch",
      "description": "Commands per transaction: under load more commands share each commit. The line of the most one batch took is MaxBatch at most (512).",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (rate({__name__=\"${ns}_writer_commands_total\", job=~\"$job\", app=~\"$app\"}[$__rate_interval])) / sum by (app) (rate({__name__=\"${ns}_writer_batches_total\", job=~\"$job\", app=~\"$app\"}[$__rate_interval]))",
          "legendFormat": "{{app}} average",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          }
        },
        {
          "refId": "B",
          "expr": "max by (app) ({__name__=\"${ns}_writer_batch_max\", job=~\"$job\", app=~\"$app\"})",
          "legendFormat": "{{app}} most",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          }
        }
      ]
    },
    {
      "id": 14,
      "title": "Commit p99",
      "description": "99th percentile of the last 1024 batches, from BEGIN to the end of COMMIT. With synchronous=FULL it includes the fsync.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (app) ({__name__=\"${ns}_writer_commit_p99_seconds\", job=~\"$job\", app=~\"$app\"})",
          "legendFormat": "{{app}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          }
        }
      ]
    },
    {
      "id": 15,
      "title": "Failures",
      "description": "Commands that returned an error or panicked, or whose batch failed, a second. A refusal a command stores as the tab's state is not a failure.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (rate({__name__=\"${ns}_writer_command_failures_total\", job=~\"$job\", app=~\"$app\"}[$__rate_interval]))",
          "legendFormat": "{{app}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          }
        }
      ]
    },
    {
      "id": 16,
      "title": "Queue",
      "description": "Commands waiting for the writer now.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (app) ({__name__=\"${ns}_writer_queue\", job=~\"$job\", app=~\"$app\"})",
          "legendFormat": "{{app}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          }
        }
      ]
    },
    {
      "id": 17,
      "title": "Writer busy",
      "description": "The share of time the writer spends in batches: near 1 it is the bottleneck.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (rate({__name__=\"${ns}_writer_busy_seconds_total\", job=~\"$job\", app=~\"$app\"}[$__rate_interval]))",
          "legendFormat": "{{app}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          }
        }
      ]
    },
    {
      "id": 18,
      "type": "row",
      "title": "Streams: the encoders' memory budget",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 51
      },
      "panels": []
    },
    {
      "id": 19,
      "title": "Budget reserved against its limit",
      "description": "The heap the open streams' encoders hold, and the limit: half of GOMEMLIMIT (or the cgroup's) unless the app sets one. 0 for the limit means none.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
