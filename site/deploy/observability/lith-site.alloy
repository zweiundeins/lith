// lith-site's logs for the host's Alloy, as /etc/alloy/lith-site.alloy. Alloy
// runs on the folder as one config, so every component label starts with lith_site.

// The journal as {job="lith-site", level}: the job comes from relabeling, since
// the source's own labels lose it once relabel_rules is set.
loki.relabel "lith_site_job" {
	forward_to = []

	rule {
		target_label = "job"
		replacement  = "lith-site"
	}
}

loki.source.journal "lith_site" {
	forward_to     = [loki.process.lith_site_logs.receiver]
	relabel_rules  = loki.relabel.lith_site_job.rules
	labels         = {job = "lith-site"}
	matches        = "SYSLOG_IDENTIFIER=lith-site"
	format_as_json = false
}

// lith-site logs slog's JSON: its level becomes a label, so an error rule is a
// label match, {job="lith-site", level="ERROR"}.
loki.process "lith_site_logs" {
	forward_to = [loki.write.default.receiver]

	stage.json {
		expressions = {level = "level"}
	}

	stage.labels {
		values = {level = "level"}
	}
}

// Caddy's access log (lith-site.caddy) as {job="caddy", site="lith"}, through
// the host's pipeline for access logs.
local.file_match "lith_site_access" {
	path_targets = [{"__path__" = "/var/log/caddy/lith-access.log", "job" = "caddy", "site" = "lith"}]
}

loki.source.file "lith_site_access" {
	targets       = local.file_match.lith_site_access.targets
	forward_to    = [loki.process.caddy_logs.receiver]
	tail_from_end = true
}
